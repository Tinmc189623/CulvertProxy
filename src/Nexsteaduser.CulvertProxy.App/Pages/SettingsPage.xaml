<Page
    x:Class="Nexsteaduser.CulvertProxy.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24,8,24,24">
        <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="修改会写入 config.json 并热加载引擎；绑定地址变化时只重启本地入口。" Style="{StaticResource Subtle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="配置向导" Click="Wizard_Click" Padding="14,8" />
                    <Button
                        Content="保存并应用"
                        Click="Save_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="18,8" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="SaveBar" IsOpen="False" IsClosable="True" />

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="本地入口" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="ListenerEnabledBox" Content="启用本地入口" VerticalAlignment="Bottom" />
                        <TextBox Grid.Column="1" x:Name="BindBox" Header="监听地址" PlaceholderText="127.0.0.1" />
                        <NumberBox Grid.Column="2" x:Name="PortBox" Header="端口" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                        <CheckBox Grid.Column="3" x:Name="LanBox" Content="允许局域网" VerticalAlignment="Bottom" />
                        <TextBox Grid.Row="1" x:Name="LocalUserBox" Header="入口用户名（可选）" />
                        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="LocalPassBox" Header="入口密码（可选）" />
                        <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" x:Name="ClearLocalPasswordBox" Content="清除已保存密码" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Text="允许局域网时必须设置用户名与密码，否则引擎拒绝启动监听。SOCKS5 与 HTTP 共用同一端口。" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="DNS 与解析" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="DnsEnableBox" Content="启用本地 DNS" VerticalAlignment="Bottom" />
                        <TextBox Grid.Column="1" x:Name="DnsBindBox" Header="DNS 监听地址" />
                        <NumberBox Grid.Column="2" x:Name="DnsPortBox" Header="DNS 端口" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                        <ComboBox Grid.Column="3" x:Name="DnsModeBox" Header="解析方式" HorizontalAlignment="Stretch" />

                        <TextBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="DohUrlBox" Header="DoH 地址" PlaceholderText="https://1.1.1.1/dns-query" />
                        <CheckBox Grid.Row="1" Grid.Column="2" x:Name="DohProxyBox" Content="DoH 走代理" VerticalAlignment="Bottom" />
                        <ComboBox Grid.Row="1" Grid.Column="3" x:Name="DohPolicyBox" Header="DoH 策略" HorizontalAlignment="Stretch" />

                        <CheckBox Grid.Row="2" x:Name="FakeIpBox" Content="fake-IP" VerticalAlignment="Bottom" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="FakeRangeBox" Header="fake-IP 网段" />
                        <CheckBox Grid.Row="2" Grid.Column="2" x:Name="FallbackBox" Content="系统回退（会泄漏）" VerticalAlignment="Bottom" />
                        <Grid Grid.Row="2" Grid.Column="3" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="DnsTimeoutBox" Header="查询超时 ms" Minimum="500" Maximum="60000" SpinButtonPlacementMode="Compact" />
                            <NumberBox Grid.Column="1" x:Name="DnsCacheBox" Header="缓存分钟" Minimum="1" Maximum="1440" SpinButtonPlacementMode="Compact" />
                        </Grid>
                    </Grid>
                    <TextBlock Text="DoH 走代理可以避免解析请求被本地网络识别；fake-IP 需要应用把 DNS 指向本机 DNS 端口，连接本地入口时会自动还原域名。启用本地 DNS 时，上游服务器地址请直接填 IP，SNI 单独填域名，否则引擎引导解析会拿到 fake-IP。" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="引擎" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="ConnectTimeoutBox" Header="连接超时 ms" Minimum="500" Maximum="120000" SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="1" x:Name="HandshakeTimeoutBox" Header="握手超时 ms" Minimum="500" Maximum="120000" SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="2" x:Name="AttemptsBox" Header="最多尝试链路" Minimum="1" Maximum="16" SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="3" x:Name="HistoryBox" Header="连接历史条数" Minimum="20" Maximum="5000" SpinButtonPlacementMode="Compact" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutboundBox" Header="出站绑定 IP（可选）" PlaceholderText="留空自动选择" />
                        <CheckBox Grid.Column="1" x:Name="StartOnLaunchBox" Content="启动时自动开启代理" VerticalAlignment="Bottom" />
                        <CheckBox Grid.Column="2" x:Name="LogConnectionsBox" Content="记录连接日志" VerticalAlignment="Bottom" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Spacing="2" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="透明接管（进程注入）" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="拦截当前用户进程的 Winsock 域名解析与 TCP 连接，交给本机规则与链路，无需在每个应用里填写代理。" Style="{StaticResource Subtle}" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="InterceptToggle"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            OnContent="已启用"
                            OffContent="未启用" />
                    </Grid>
                    <Grid ColumnSpacing="14" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="InterceptExistingBox" Content="接管已在运行的进程" />
                        <CheckBox Grid.Column="1" x:Name="InterceptAutoBox" Content="跟随新启动的进程" />
                        <CheckBox Grid.Column="2" x:Name="InterceptFailOpenBox" Content="入口不可用时回退直连" />
                    </Grid>
                    <TextBox
                        x:Name="InterceptExcludeBox"
                        Header="排除进程（每行一个，支持 * 和 ?）"
                        AcceptsReturn="True"
                        Height="78"
                        TextWrapping="Wrap"
                        PlaceholderText="game.exe&#x0a;D:\Tools\*.exe" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InterceptStatusText" Style="{StaticResource Subtle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="InjectNowButton" Content="立即扫描并接管" Click="InjectNow_Click" />
                    </Grid>
                    <InfoBar x:Name="InterceptBar" IsOpen="False" IsClosable="True" />
                    <TextBlock Text="x64 用户态注入，无需内核驱动。高完整性进程需要以管理员身份运行 CulvertProxy；UDP/QUIC 不转发，fake-IP 的 QUIC 会被阻断以促使应用回落 TCP。回退直连会绕过代理并泄漏真实地址，抗审查环境请保持关闭。" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="外观与系统集成" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ThemeBox" Header="主题" HorizontalAlignment="Stretch" />
                        <CheckBox Grid.Column="1" x:Name="CloseToTrayBox" Content="关闭窗口时留在托盘" VerticalAlignment="Bottom" />
                        <CheckBox Grid.Column="2" x:Name="MinimizeToTrayBox" Content="最小化时留在托盘" VerticalAlignment="Bottom" />
                        <CheckBox Grid.Column="3" x:Name="StartWithWindowsBox" Content="开机自动启动" VerticalAlignment="Bottom" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="SystemProxyToggle" Header="系统代理 (PAC)" Toggled="SystemProxy_Toggled" OnContent="已启用" OffContent="未启用" />
                        <TextBlock Grid.Column="1" x:Name="SystemProxyStatus" VerticalAlignment="Bottom" Margin="0,0,0,10" Style="{StaticResource Subtle}" />
                        <Button Grid.Column="2" Content="打开配置目录" Click="OpenConfig_Click" VerticalAlignment="Bottom" />
                        <Button Grid.Column="3" Content="打开日志目录" Click="OpenLogs_Click" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Text="系统代理通过当前用户注册表接管 WinINET，浏览器与大多数桌面应用会自动读取 PAC；退出应用时恢复原设置。" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="CulvertProxy 1.0.0" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="Nexsteaduser" Style="{StaticResource Subtle}" />
                    <TextBlock Text="SOCKS5 / HTTP 混合入口 · 多跳链路 · DoH · fake-IP · 进程归属" Style="{StaticResource Subtle}" />
                    <TextBlock Text="Copyright © 2026 Nexsteaduser. All Rights Reserved" Style="{StaticResource Subtle}" Margin="0,6,0,0" />
                    <TextBlock x:Name="ConfigPathText" Style="{StaticResource Mono}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
